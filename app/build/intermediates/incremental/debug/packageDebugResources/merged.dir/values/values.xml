<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="olivia_acc">#FF7AA2FF</color>
    <color name="olivia_acc2">#FFB48CFF</color>
    <color name="olivia_bg">#FF070A12</color>
    <color name="olivia_fg">#FFE8EEF9</color>
    <color name="olivia_mut">#FF8B97AD</color>
    <color name="olivia_panel">#CC111726</color>
    <color name="olivia_panel2">#FF1A2233</color>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="white">#FFFFFFFF</color>
    <string name="accessibility_service_description">Allows Olivia to read screen content and perform gestures for app control.</string>
    <string name="accessibility_service_name">Olivia Accessibility</string>
    <string name="app_name">Olivia Native</string>
    <style name="Theme.Andee" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/olivia_acc</item>
        <item name="colorPrimaryVariant">@color/olivia_acc2</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/olivia_bg</item>
        <item name="colorSurface">@color/olivia_panel2</item>
        <item name="colorOnSurface">@color/olivia_fg</item>
    </style>
    <style name="Theme.Andee.NoActionBar" parent="Theme.Andee">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Theme.Andee.Splash" parent="Theme.Andee">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
    <style name="Theme.Andee.Transparent" parent="Theme.Andee">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>